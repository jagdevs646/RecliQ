# Build context of the Azure images (docker/*.azure.Dockerfile, built from the
# repository root; az acr build uploads this context to Azure). They copy only
# backend/ and frontend/, so everything else stays out.
*
!backend
!frontend
!docker

# Local-only files inside those folders: settings with secrets, databases,
# uploads, virtual environments, caches and build output. Patterns need **/
# or a folder prefix, because a bare name matches only at the root.
**/.env
**/.env.*
**/*.db
**/*.db-journal
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.venv
**/node_modules
backend/venv
backend/storage
frontend/dist
frontend/.vite
