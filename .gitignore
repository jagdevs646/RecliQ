# Ignore local secret env files but allow committed production/example files
.env
.env.local
.env.*.local
!.env.example
!.env.production
.venv/
venv/
backend/venv/
__pycache__/
*.pyc
# Ignore uploaded-file storage dirs but NOT the app/storage Python module
/storage/
/backend/storage/
dist/
node_modules/
reconx_dev.db
recliq_dev.db
.pytest_cache/
.idea/
*.docx
~$*
scratch/
backend/test_report_output.xlsx
RecliQ_Custom_Report.xlsx

# Credentials must never be committed: keep them in environment variables or
# a managed secret store (Azure Key Vault, GitHub Actions secrets).
AzureCloud*.txt
*credentials*.txt
*secret*.txt
*.pem
*.pfx
*.key
.env.production.local
