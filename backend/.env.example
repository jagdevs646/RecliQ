# Copy to backend/.env for local development. Never commit real values:
# production secrets come from the hosting platform's settings as environment
# variables (Render's environment, or Container App secrets on Azure).
APP_NAME=RecliQ
ENVIRONMENT=development
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false

# Accounts use opaque server-side sessions (no JWT). Set a random secret of at
# least 32 characters before enabling accounts outside local development.
AUTH_CSRF_SECRET=
AUTH_SESSION_DAYS=30
AUTH_MAX_ATTEMPTS=8
AUTH_ATTEMPT_WINDOW_MINUTES=15
REGISTRATION_ENABLED=true
# Optional first-admin bootstrap. Supply all four values together; there is no
# default administrator. TOTP secret must be base32 and kept in a secret store.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TOTP_SECRET=

# Use EMAIL_BACKEND=log only for local development. Production email features
# require a verified SMTP provider; credentials belong in a secret store.
EMAIL_BACKEND=log
SMTP_HOST=
SMTP_PORT=587
# For Gmail SMTP, use the Gmail account address and a Google App Password.
SMTP_USERNAME=jagdev.s65@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=jagdev.s65@gmail.com
SMTP_FROM_NAME=RecliQ
SMTP_STARTTLS=true
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000/api
REPORT_LINK_HOURS=24

# Optional OAuth application credentials; providers stay hidden until both
# client values are set and the corresponding feature is enabled by an admin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

DATABASE_URL=postgresql+psycopg://recliq:recliq@postgres:5432/recliq

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=recliq

# Upload limits
MAX_UPLOAD_MB=50
MAX_ROWS_PER_SHEET=500000

# Jobs: "redis" for durable workers (python -m app.jobs.worker), "local" for
# an in-process pool during development.
JOB_QUEUE_BACKEND=local
REDIS_URL=redis://localhost:6379/0
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=180
JOB_TIMEOUT_SECONDS=3600

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
RELEASE=
