# Copy to backend/.env for local development. Never commit real values:
# production secrets come from the platform's secret store as environment
# variables (Azure Key Vault references, Render/GitHub secrets).
APP_NAME=RecliQ
ENVIRONMENT=development
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_SECURE=false

DATABASE_URL=postgresql+psycopg://recliq:recliq@postgres:5432/recliq

STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=recliq

# Upload limits
MAX_UPLOAD_MB=50
MAX_ROWS_PER_SHEET=500000

# Jobs: "redis" for durable workers (python -m app.jobs.worker), "local" for
# an in-process pool during development.
JOB_QUEUE_BACKEND=local
REDIS_URL=redis://localhost:6379/0
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=180
JOB_TIMEOUT_SECONDS=3600

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
RELEASE=
